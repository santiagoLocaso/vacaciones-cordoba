---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Alojamientos from "../components/Alojamientos.astro";
import Asistencia from "../components/Asistencia.astro";
import Transporte from "../components/Transporte.astro";
import Tareas from "../components/Tareas.astro";
import GuiaCarlosPaz from "../components/GuiaCarlosPaz.astro";
---

<Layout title="Vacaciones Carlos Paz 2026">
  <Navbar />

  <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Alojamientos />
    <Asistencia />
    <Transporte />
    <Tareas />
    <GuiaCarlosPaz />
  </main>

  <footer
    class="border-t border-slate-800/80 py-6 text-center text-slate-500 text-xs"
  >
    Vacaciones Córdoba 2026 • Creado con Astro y Supabase
  </footer>
</Layout>

<script>
  import { _supabase } from "../lib/supabase.js";

  // ESTADO LOCAL TIPADO
  let alojamientos: any[] = [];
  let asistencias: any[] = [];
  let autos: Record<string, string[]> = { "Santi G": [], "Santi R": [] };
  let tareas: any[] = [];

  // NAVEGACIÓN GLOBAL
  (window as any).switchTab = function (tabId: string) {
    document
      .querySelectorAll(".tab-content")
      .forEach((el) => el.classList.add("hidden"));
    const selected = document.getElementById("tab-" + tabId);
    if (selected) selected.classList.remove("hidden");

    document.querySelectorAll(".tab-btn").forEach((btn) => {
      btn.className =
        "tab-btn flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-200 text-slate-400 hover:text-slate-200 hover:bg-slate-800/50";
    });

    const activeBtn = document.getElementById("tab-btn-" + tabId);
    if (activeBtn) {
      activeBtn.className =
        "tab-btn flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-200 text-sky-400 bg-slate-800 shadow-sm border border-slate-700/50";
    }

    if ((window as any).lucide) (window as any).lucide.createIcons();
  };

  (window as any).toggleModal = function (modalId: string) {
    const modal = document.getElementById(modalId);
    if (modal) {
      if (modal.classList.contains("hidden")) {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
      } else {
        modal.classList.remove("flex");
        modal.classList.add("hidden");
      }
    }
  };

  function formatearPrecio(valor: string | number) {
    if (!valor) return "$ 0";
    // Limpiamos cualquier caracter que no sea número
    const numero = Number(String(valor).replace(/\D/g, ""));
    if (isNaN(numero) || numero === 0) return String(valor); // Si ingresaron texto libre, lo devuelve tal cual
    return new Intl.NumberFormat("es-AR", {
      style: "currency",
      currency: "ARS",
      maximumFractionDigits: 0,
    }).format(numero);
  }

  // --- 1. ALOJAMIENTOS ---
  async function cargarAlojamientos() {
    const { data, error } = await _supabase
      .from("alojamientos")
      .select("*")
      .order("id", { ascending: false });
    if (error) {
      console.error("Error al cargar alojamientos:", error);
      return;
    }
    alojamientos = data || [];
    renderAlojamientos();
  }

  function renderAlojamientos() {
    const container = document.getElementById("alojamientos-container");
    if (!container) return;
    container.innerHTML = "";

    if (alojamientos.length === 0) {
      container.innerHTML = `<p class="text-slate-500 text-sm col-span-full text-center py-8">Todavía no hay propuestas. ¡Sé el primero en proponer una!</p>`;
      return;
    }

    alojamientos.forEach((item: any) => {
      const votos = item.votos || [];
      const card = document.createElement("div");
      card.className =
        "glass-card rounded-3xl overflow-hidden flex flex-col border border-slate-700/60";
      card.innerHTML = `
        <div class="h-48 bg-slate-800 relative overflow-hidden">
          <img src="${item.imagen || "https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=800&q=80"}" class="w-full h-full object-cover">
          <div class="absolute top-3 right-3 bg-slate-900/80 backdrop-blur-md px-3 py-1 rounded-full text-xs font-bold text-sky-400 border border-slate-700">
            ${formatearPrecio(item.precio)}
          </div>
          <div class="absolute bottom-3 left-3 bg-slate-900/80 backdrop-blur-md px-3 py-1 rounded-full text-xs font-medium text-slate-200 flex items-center gap-1 border border-slate-700">
            <i data-lucide="user" class="w-3 h-3 text-sky-400"></i> Propuesto por: ${item.proponente || "Anónimo"}
          </div>
        </div>
        <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
          <div>
            <h3 class="font-bold text-lg text-white">${item.titulo}</h3>
            <p class="text-xs text-slate-400 mt-1 flex items-center gap-1"><i data-lucide="map-pin" class="w-3.5 h-3.5 text-rose-400"></i> ${item.ubicacion || "Carlos Paz"}</p>
            <p class="text-slate-300 text-sm mt-3 leading-relaxed">${item.notas || ""}</p>
          </div>
          <div class="pt-3 border-t border-slate-800 space-y-3">
            <div class="flex items-center justify-between text-xs text-slate-400">
              <span>Votos: ${votos.length}</span>
              <a href="${item.link}" target="_blank" class="text-sky-400 hover:underline flex items-center gap-1">Ver Link <i data-lucide="external-link" class="w-3 h-3"></i></a>
            </div>
            <div class="flex gap-2">
              <button onclick="window.votarAlojamiento(${item.id})" class="flex-1 py-2 rounded-xl bg-sky-500/10 hover:bg-sky-500/20 text-sky-400 font-semibold text-xs border border-sky-500/30 flex items-center justify-center gap-1">
                <i data-lucide="thumbs-up" class="w-3.5 h-3.5"></i> Votar
              </button>
              <button onclick="window.borrarAlojamiento(${item.id})" class="p-2 rounded-xl bg-rose-500/10 text-rose-400 hover:bg-rose-500/20 border border-rose-500/30">
                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
              </button>
            </div>
          </div>
        </div>
      `;
      container.appendChild(card);
    });
    if ((window as any).lucide) (window as any).lucide.createIcons();
  }

  (window as any).guardarAlojamiento = async function (e: Event) {
    e.preventDefault();
    const proponente = (
      document.getElementById("alojamiento-proponente") as HTMLInputElement
    ).value;
    const titulo = (
      document.getElementById("alojamiento-titulo") as HTMLInputElement
    ).value;
    const precio = (
      document.getElementById("alojamiento-precio") as HTMLInputElement
    ).value;
    const ubicacion = (
      document.getElementById("alojamiento-ubicacion") as HTMLInputElement
    ).value;
    const imagen = (
      document.getElementById("alojamiento-imagen") as HTMLInputElement
    ).value;
    const link = (
      document.getElementById("alojamiento-link") as HTMLInputElement
    ).value;
    const notas = (
      document.getElementById("alojamiento-notas") as HTMLTextAreaElement
    ).value;

    const { error } = await _supabase.from("alojamientos").insert([
      {
        proponente,
        titulo,
        precio,
        ubicacion,
        imagen,
        link,
        notas,
        votos: [],
      },
    ]);

    if (!error) {
      await cargarAlojamientos();
      (window as any).toggleModal("modal-alojamiento");
      (document.getElementById("form-alojamiento") as HTMLFormElement).reset();
    } else {
      alert("Error al guardar: " + error.message);
    }
  };

  (window as any).votarAlojamiento = async function (id: number) {
    const item = alojamientos.find((a: any) => a.id === id);
    if (!item) return;

    const nuevosVotos = item.votos || [];
    nuevosVotos.push("voto"); // Agrega un elemento para incrementar la cantidad

    const { error } = await _supabase
      .from("alojamientos")
      .update({ votos: nuevosVotos })
      .eq("id", id);
    if (!error) cargarAlojamientos();
  };

  (window as any).borrarAlojamiento = async function (id: number) {
    if (!confirm("¿Querés borrar esta propuesta?")) return;
    const { error } = await _supabase
      .from("alojamientos")
      .delete()
      .eq("id", id);
    if (!error) cargarAlojamientos();
  };

  // --- 2. ASISTENCIA ---
  async function cargarAsistencia() {
    const { data, error } = await _supabase
      .from("asistencias")
      .select("*")
      .order("nombre", { ascending: true });
    if (error) return;
    asistencias = data || [];
    renderAsistencia();
  }

  function renderAsistencia() {
    const container = document.getElementById("asistencia-container");
    if (!container) return;
    container.innerHTML = "";

    let confirmados = 0,
      probables = 0,
      bajados = 0;

    asistencias.forEach((item: any) => {
      if (item.estado === "confirmado") confirmados++;
      if (item.estado === "probable") probables++;
      if (item.estado === "bajado") bajados++;

      const badgeColor =
        item.estado === "confirmado"
          ? "bg-emerald-500/20 text-emerald-400 border-emerald-500/30"
          : item.estado === "probable"
            ? "bg-amber-500/20 text-amber-400 border-amber-500/30"
            : "bg-rose-500/20 text-rose-400 border-rose-500/30";

      const card = document.createElement("div");
      card.className =
        "glass-card p-4 rounded-2xl flex items-center justify-between border border-slate-700/50";
      card.innerHTML = `
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center font-bold text-white text-sm border border-slate-700">
            ${item.nombre.charAt(0).toUpperCase()}
          </div>
          <div>
            <h4 class="font-bold text-white text-sm">${item.nombre}</h4>
            <p class="text-xs text-slate-400">${item.comentario || "Sin comentario"}</p>
          </div>
        </div>
        <span class="px-3 py-1 rounded-full text-xs font-bold border uppercase tracking-wider ${badgeColor}">
          ${item.estado}
        </span>
      `;
      container.appendChild(card);
    });

    const c1 = document.getElementById("count-confirmados");
    const c2 = document.getElementById("count-probables");
    const c3 = document.getElementById("count-bajados");
    if (c1) c1.innerText = confirmados.toString();
    if (c2) c2.innerText = probables.toString();
    if (c3) c3.innerText = bajados.toString();
  }

  (window as any).guardarAsistencia = async function (e: Event) {
    e.preventDefault();
    const nombre = (
      document.getElementById("asistencia-nombre") as HTMLInputElement
    ).value;
    const estado = (
      document.getElementById("asistencia-estado") as HTMLSelectElement
    ).value;
    const comentario = (
      document.getElementById("asistencia-comentario") as HTMLInputElement
    ).value;

    const { error } = await _supabase
      .from("asistencias")
      .upsert({ nombre, estado, comentario }, { onConflict: "nombre" });

    if (!error) {
      cargarAsistencia();
      (document.getElementById("form-asistencia") as HTMLFormElement).reset();
    }
  };

  // --- 3. TRANSPORTE ---
  async function cargarTransporte() {
    const { data, error } = await _supabase.from("autos").select("*");
    if (error) return;

    autos = { "Santi G": [], "Santi R": [] };
    (data || []).forEach((row: any) => {
      if (!autos[row.dueno]) autos[row.dueno] = [];
      autos[row.dueno].push(row.pasajero);
    });
    renderTransporte();
  }

  function renderTransporte() {
    ["Santi G", "Santi R"].forEach((dueno) => {
      const key = dueno === "Santi G" ? "santi-g" : "santi-r";
      const container = document.getElementById("pasajeros-" + key);
      if (!container) return;
      container.innerHTML = "";

      const lista = autos[dueno] || [];
      lista.forEach((pasajero) => {
        const item = document.createElement("div");
        item.className =
          "flex items-center justify-between bg-slate-900/60 p-3 rounded-xl border border-slate-800 text-sm text-slate-200";
        item.innerHTML = `
          <span class="flex items-center gap-2">
            <i data-lucide="user-check" class="w-4 h-4 text-emerald-400"></i> ${pasajero}
          </span>
          <button onclick="window.bajarDelAuto('${dueno}', '${pasajero}')" class="text-slate-500 hover:text-rose-400">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        `;
        container.appendChild(item);
      });
    });
    if ((window as any).lucide) (window as any).lucide.createIcons();
  }

  (window as any).subirAlAuto = async function (e: Event, dueno: string) {
    e.preventDefault();
    const inputId =
      dueno === "Santi G" ? "nombre-auto-santi-g" : "nombre-auto-santi-r";
    const nombre = (document.getElementById(inputId) as HTMLInputElement).value;
    if (!nombre) return;

    await _supabase.from("autos").delete().eq("pasajero", nombre);
    await _supabase.from("autos").insert([{ dueno, pasajero: nombre }]);

    cargarTransporte();
    (document.getElementById(inputId) as HTMLInputElement).value = "";
  };

  (window as any).bajarDelAuto = async function (
    dueno: string,
    pasajero: string,
  ) {
    await _supabase
      .from("autos")
      .delete()
      .eq("dueno", dueno)
      .eq("pasajero", pasajero);
    cargarTransporte();
  };

  // --- 4. TAREAS ---
  async function cargarTareas() {
    const { data, error } = await _supabase
      .from("tareas")
      .select("*")
      .order("id", { ascending: false });
    if (error) return;
    tareas = data || [];
    renderTareas();
  }

  function renderTareas() {
    const container = document.getElementById("tareas-container");
    if (!container) return;
    container.innerHTML = "";

    tareas.forEach((t: any) => {
      const item = document.createElement("div");
      item.className = `glass-card p-5 rounded-2xl border flex flex-col justify-between ${t.completada ? "border-emerald-500/30 bg-emerald-950/10" : "border-slate-700/60"}`;
      item.innerHTML = `
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-purple-950 text-purple-300 border border-purple-800/40">${t.categoria}</span>
            <button onclick="window.borrarTarea(${t.id})" class="text-slate-500 hover:text-rose-400"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
          </div>
          <h4 class="font-bold text-base text-white ${t.completada ? "line-through text-slate-400" : ""}">${t.titulo}</h4>
          <p class="text-xs text-slate-400">Asignado a: <span class="text-slate-200 font-semibold">${t.asignado || "Sin asignar"}</span></p>
        </div>
        <div class="pt-4 mt-3 border-t border-slate-800/80 flex items-center justify-between">
          <button onclick="window.toggleTarea(${t.id}, ${t.completada})" class="text-xs font-bold flex items-center gap-1.5 ${t.completada ? "text-emerald-400" : "text-slate-400 hover:text-white"}">
            <i data-lucide="${t.completada ? "check-circle-2" : "circle"}" class="w-4 h-4"></i>
            ${t.completada ? "Completada" : "Marcar lista"}
          </button>
        </div>
      `;
      container.appendChild(item);
    });
    if ((window as any).lucide) (window as any).lucide.createIcons();
  }

  (window as any).guardarTarea = async function (e: Event) {
    e.preventDefault();
    const titulo = (document.getElementById("tarea-titulo") as HTMLInputElement)
      .value;
    const asignado = (
      document.getElementById("tarea-asignado") as HTMLInputElement
    ).value;
    const categoria = (
      document.getElementById("tarea-categoria") as HTMLSelectElement
    ).value;

    const { error } = await _supabase
      .from("tareas")
      .insert([{ titulo, asignado, categoria, completada: false }]);

    if (!error) {
      cargarTareas();
      (window as any).toggleModal("modal-tarea");
      (document.getElementById("form-tarea") as HTMLFormElement).reset();
    }
  };

  (window as any).toggleTarea = async function (
    id: number,
    estadoActual: boolean,
  ) {
    await _supabase
      .from("tareas")
      .update({ completada: !estadoActual })
      .eq("id", id);
    cargarTareas();
  };

  (window as any).borrarTarea = async function (id: number) {
    await _supabase.from("tareas").delete().eq("id", id);
    cargarTareas();
  };

  // INICIALIZACIÓN
  document.addEventListener("DOMContentLoaded", () => {
    cargarAlojamientos();
    cargarAsistencia();
    cargarTransporte();
    cargarTareas();
  });
</script>
