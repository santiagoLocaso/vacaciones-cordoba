---

---

<section id="tab-alojamientos" class="tab-content space-y-8">
  <div
    class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-slate-800/40 p-6 rounded-3xl border border-slate-700/50"
  >
    <div>
      <h2 class="text-2xl font-bold text-white flex items-center gap-3">
        <i data-lucide="building-2" class="text-sky-400 w-7 h-7"></i>
        Propuestas de Alojamiento
      </h2>
      <p class="text-slate-400 text-sm mt-1">
        Cargá opciones con fotos, precios y links para votar entre todos.
      </p>
    </div>
    <button
      onclick="toggleModal('modal-alojamiento')"
      class="w-full md:w-auto px-5 py-3 rounded-xl bg-gradient-to-r from-sky-500 to-teal-500 text-white font-bold hover:from-sky-400 hover:to-teal-400 transition shadow-lg shadow-sky-500/20 flex items-center justify-center gap-2"
    >
      <i data-lucide="plus" class="w-5 h-5"></i>
      Proponer Alojamiento
    </button>
  </div>

  <!-- Contenedor de Cards -->
  <div
    id="alojamientos-container"
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
  >
    <!-- Renderizado vía Javascript local -->
  </div>
</section>

<!-- Modal Alojamiento -->
<div
  id="modal-alojamiento"
  class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden justify-center items-center p-4"
>
  <div
    class="glass-card max-w-lg w-full rounded-3xl p-6 sm:p-8 space-y-6 max-h-[90vh] overflow-y-auto custom-scrollbar"
  >
    <div
      class="flex items-center justify-between border-b border-slate-800 pb-4"
    >
      <h3 class="text-xl font-bold text-white flex items-center gap-2">
        <i data-lucide="plus-circle" class="text-sky-400 w-6 h-6"></i>
        Nueva Opción
      </h3>
      <button
        onclick="toggleModal('modal-alojamiento')"
        class="text-slate-400 hover:text-white"
      >
        <i data-lucide="x" class="w-6 h-6"></i>
      </button>
    </div>

    <form
      id="form-alojamiento"
      onsubmit="guardarAlojamiento(event)"
      class="space-y-4"
    >
      <div>
        <label
          class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5"
          >Tu Nombre (Proponente)</label
        >
        <input
          type="text"
          id="alojamiento-proponente"
          required
          placeholder="Ej: Santi G"
          class="w-full px-4 py-3 rounded-xl glass-input text-white text-sm focus:ring-2 focus:ring-sky-500"
        />
      </div>
      <div>
        <label
          class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5"
          >Título del Alojamiento</label
        >
        <input
          type="text"
          id="alojamiento-titulo"
          required
          placeholder="Ej: Cabaña con pileta cerca del Lago"
          class="w-full px-4 py-3 rounded-xl glass-input text-white text-sm focus:ring-2 focus:ring-sky-500"
        />
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label
            class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5"
            >Precio Total (ARS / USD)</label
          >
          <input
            type="text"
            id="alojamiento-precio"
            required
            placeholder="Ej: $450.000"
            class="w-full px-4 py-3 rounded-xl glass-input text-white text-sm focus:ring-2 focus:ring-sky-500"
          />
        </div>
        <div>
          <label
            class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5"
            >Ubicación</label
          >
          <input
            type="text"
            id="alojamiento-ubicacion"
            placeholder="Ej: Villa Carlos Paz"
            class="w-full px-4 py-3 rounded-xl glass-input text-white text-sm focus:ring-2 focus:ring-sky-500"
          />
        </div>
      </div>
      <div>
        <label
          class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5"
          >URL de Foto (opcional)</label
        >
        <input
          type="url"
          id="alojamiento-imagen"
          placeholder="https://..."
          class="w-full px-4 py-3 rounded-xl glass-input text-white text-sm focus:ring-2 focus:ring-sky-500"
        />
      </div>
      <div>
        <label
          class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5"
          >Link de Airbnb / Booking / IG</label
        >
        <input
          type="url"
          id="alojamiento-link"
          required
          placeholder="https://airbnb.com/..."
          class="w-full px-4 py-3 rounded-xl glass-input text-white text-sm focus:ring-2 focus:ring-sky-500"
        />
      </div>
      <div>
        <label
          class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5"
          >Detalles / Notas</label
        >
        <textarea
          id="alojamiento-notas"
          rows="3"
          placeholder="Tiene quincho, asador, garage para 2 autos..."
          class="w-full px-4 py-3 rounded-xl glass-input text-white text-sm focus:ring-2 focus:ring-sky-500"
        ></textarea>
      </div>

      <div class="pt-4 flex items-center justify-end gap-3">
        <button
          type="button"
          onclick="toggleModal('modal-alojamiento')"
          class="px-5 py-2.5 rounded-xl text-slate-400 hover:text-white font-semibold text-sm"
          >Cancelar</button
        >
        <button
          type="submit"
          class="px-6 py-2.5 rounded-xl bg-sky-500 hover:bg-sky-400 text-white font-bold text-sm shadow-lg shadow-sky-500/20"
          >Guardar Propuesta</button
        >
      </div>
    </form>
  </div>
</div>
