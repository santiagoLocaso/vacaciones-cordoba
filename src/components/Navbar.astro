---

---

<header
  class="sticky top-0 z-50 w-full border-b border-slate-800/80 bg-slate-900/90 backdrop-blur-md shadow-xl"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="flex flex-col md:flex-row items-center justify-between gap-4 py-4"
    >
      <!-- Brand / Logo -->
      <div class="flex items-center gap-3">
        <div
          class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-sky-500 via-teal-400 to-amber-400 p-0.5 shadow-lg shadow-sky-500/20"
        >
          <div
            class="w-full h-full bg-slate-900 rounded-[14px] flex items-center justify-center"
          >
            <i data-lucide="mountain-snow" class="w-6 h-6 text-sky-400"></i>
          </div>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1
              class="font-extrabold text-xl tracking-tight bg-gradient-to-r from-sky-400 via-teal-300 to-amber-200 bg-clip-text text-transparent"
            >
              Carlos Paz 2026
            </h1>
            <span
              class="text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full bg-sky-950 text-sky-400 border border-sky-800/50"
              >Córdoba</span
            >
          </div>
          <p class="text-xs text-slate-400">Organizador de Vacaciones</p>
        </div>
      </div>

      <!-- Navigation Tabs (Siempre visibles) -->
      <nav
        class="flex flex-wrap items-center justify-center gap-1.5 bg-slate-950/60 p-1.5 rounded-2xl border border-slate-800/80"
      >
        <button
          onclick="switchTab('alojamientos')"
          id="tab-btn-alojamientos"
          class="tab-btn flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 text-sky-400 bg-slate-800 shadow-sm border border-slate-700/50"
        >
          <i data-lucide="home" class="w-4 h-4"></i>
          <span>Alojamientos</span>
        </button>
        <button
          onclick="switchTab('asistencia')"
          id="tab-btn-asistencia"
          class="tab-btn flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 text-slate-400 hover:text-slate-200 hover:bg-slate-800/50"
        >
          <i data-lucide="users" class="w-4 h-4"></i>
          <span>Asistencia</span>
        </button>
        <button
          onclick="switchTab('transporte')"
          id="tab-btn-transporte"
          class="tab-btn flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 text-slate-400 hover:text-slate-200 hover:bg-slate-800/50"
        >
          <i data-lucide="car" class="w-4 h-4"></i>
          <span>Transporte</span>
        </button>
        <button
          onclick="switchTab('tareas')"
          id="tab-btn-tareas"
          class="tab-btn flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 text-slate-400 hover:text-slate-200 hover:bg-slate-800/50"
        >
          <i data-lucide="check-square" class="w-4 h-4"></i>
          <span>Tareas</span>
        </button>
        <button
          onclick="switchTab('guia')"
          id="tab-btn-guia"
          class="tab-btn flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 text-slate-400 hover:text-slate-200 hover:bg-slate-800/50"
        >
          <i data-lucide="compass" class="w-4 h-4"></i>
          <span>Guía & Tips</span>
        </button>
      </nav>
    </div>
  </div>
</header>
