---

---

<section id="tab-asistencia" class="tab-content hidden space-y-8">
  <div class="bg-slate-800/40 p-6 rounded-3xl border border-slate-700/50">
    <h2 class="text-2xl font-bold text-white flex items-center gap-3">
      <i data-lucide="user-check" class="text-teal-400 w-7 h-7"></i>
      ¿Quiénes van?
    </h2>
    <p class="text-slate-400 text-sm mt-1">
      Anotate y confirmá tu disponibilidad para ir organizando lugares en autos
      y camas.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Formulario de Registro -->
    <div class="glass-card p-6 rounded-3xl h-fit border border-slate-700/60">
      <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
        <i data-lucide="user-plus" class="text-teal-400 w-5 h-5"></i>
        Registrar o Actualizar Estado
      </h3>
      <form
        id="form-asistencia"
        onsubmit="guardarAsistencia(event)"
        class="space-y-4"
      >
        <div>
          <label
            class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5"
            >Tu Nombre</label
          >
          <input
            type="text"
            id="asistencia-nombre"
            required
            placeholder="Ej: Juan, Mateo, Nico..."
            class="w-full px-4 py-3 rounded-xl glass-input text-white text-sm focus:ring-2 focus:ring-teal-500"
          />
        </div>
        <div>
          <label
            class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5"
            >Estado de Confirmación</label
          >
          <select
            id="asistencia-estado"
            class="w-full px-4 py-3 rounded-xl glass-input text-white text-sm focus:ring-2 focus:ring-teal-500 bg-slate-900"
          >
            <option value="confirmado">Confirmadísimo 🔥</option>
            <option value="probable">En duda / Probable ❓</option>
            <option value="bajado">No llego a ir ❌</option>
          </select>
        </div>
        <div>
          <label
            class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5"
            >Comentario / Fechas disponibles</label
          >
          <input
            type="text"
            id="asistencia-comentario"
            placeholder="Ej: Voy seguro del 10 al 18"
            class="w-full px-4 py-3 rounded-xl glass-input text-white text-sm focus:ring-2 focus:ring-teal-500"
          />
        </div>
        <button
          type="submit"
          class="w-full py-3 rounded-xl bg-gradient-to-r from-teal-500 to-emerald-500 hover:from-teal-400 hover:to-emerald-400 text-white font-bold text-sm shadow-lg shadow-teal-500/20 transition flex items-center justify-center gap-2"
        >
          <i data-lucide="check" class="w-4 h-4"></i> Guardar Estado
        </button>
      </form>
    </div>

    <!-- Contadores y Lista -->
    <div class="lg:col-span-2 space-y-6">
      <div class="grid grid-cols-3 gap-4">
        <div
          class="glass-card p-4 rounded-2xl text-center border-l-4 border-l-emerald-500"
        >
          <span class="text-xs font-bold uppercase text-slate-400 block mb-1"
            >Confirmados</span
          >
          <span
            id="count-confirmados"
            class="text-3xl font-extrabold text-emerald-400">0</span
          >
        </div>
        <div
          class="glass-card p-4 rounded-2xl text-center border-l-4 border-l-amber-500"
        >
          <span class="text-xs font-bold uppercase text-slate-400 block mb-1"
            >En Duda</span
          >
          <span
            id="count-probables"
            class="text-3xl font-extrabold text-amber-400">0</span
          >
        </div>
        <div
          class="glass-card p-4 rounded-2xl text-center border-l-4 border-l-rose-500"
        >
          <span class="text-xs font-bold uppercase text-slate-400 block mb-1"
            >No Van</span
          >
          <span id="count-bajados" class="text-3xl font-extrabold text-rose-400"
            >0</span
          >
        </div>
      </div>

      <div id="asistencia-container" class="space-y-3">
        <!-- Renderizado de Amigos -->
      </div>
    </div>
  </div>
</section>
