---

---

<section id="tab-transporte" class="tab-content hidden space-y-8">
  <div class="bg-slate-800/40 p-6 rounded-3xl border border-slate-700/50">
    <h2 class="text-2xl font-bold text-white flex items-center gap-3">
      <i data-lucide="car" class="text-amber-400 w-7 h-7"></i>
      Organización del Transporte
    </h2>
    <p class="text-slate-400 text-sm mt-1">
      Repartite en los autos disponibles para el viaje a Carlos Paz.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <!-- Auto Santi G -->
    <div
      class="glass-card p-6 rounded-3xl border border-slate-700/60 space-y-6 relative overflow-hidden"
    >
      <div
        class="absolute -top-10 -right-10 w-32 h-32 bg-sky-500/10 rounded-full blur-2xl pointer-events-none"
      >
      </div>
      <div
        class="flex items-center justify-between border-b border-slate-800 pb-4"
      >
        <div>
          <span class="text-xs font-bold text-sky-400 uppercase tracking-widest"
            >Vehículo 1</span
          >
          <h3
            class="text-2xl font-extrabold text-white flex items-center gap-2 mt-0.5"
          >
            Auto de Santi G
          </h3>
        </div>
        <div
          class="w-12 h-12 rounded-2xl bg-sky-500/20 text-sky-400 flex items-center justify-center font-bold"
        >
          <i data-lucide="car" class="w-6 h-6"></i>
        </div>
      </div>

      <div>
        <h4
          class="text-xs font-bold uppercase text-slate-400 mb-3 tracking-wider"
        >
          Pasajeros Confirmados:
        </h4>
        <div id="pasajeros-santi-g" class="space-y-2 min-h-24">
          <!-- Lista JS -->
        </div>
      </div>

      <form
        onsubmit="subirAlAuto(event, 'Santi G')"
        class="pt-2 border-t border-slate-800/80 space-y-3"
      >
        <label class="block text-xs font-bold uppercase text-slate-300"
          >Sumarme a este auto</label
        >
        <div class="flex gap-2">
          <input
            type="text"
            id="nombre-auto-santi-g"
            required
            placeholder="Tu nombre"
            class="flex-1 px-4 py-2.5 rounded-xl glass-input text-white text-sm focus:ring-2 focus:ring-sky-500"
          />
          <button
            type="submit"
            class="px-4 py-2.5 rounded-xl bg-sky-500 hover:bg-sky-400 text-white font-bold text-sm transition flex items-center gap-1 shadow-lg shadow-sky-500/20"
          >
            <i data-lucide="user-plus" class="w-4 h-4"></i>
            Subirme
          </button>
        </div>
      </form>
    </div>

    <!-- Auto Santi R -->
    <div
      class="glass-card p-6 rounded-3xl border border-slate-700/60 space-y-6 relative overflow-hidden"
    >
      <div
        class="absolute -top-10 -right-10 w-32 h-32 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"
      >
      </div>
      <div
        class="flex items-center justify-between border-b border-slate-800 pb-4"
      >
        <div>
          <span
            class="text-xs font-bold text-amber-400 uppercase tracking-widest"
            >Vehículo 2</span
          >
          <h3
            class="text-2xl font-extrabold text-white flex items-center gap-2 mt-0.5"
          >
            Auto de Santi R
          </h3>
        </div>
        <div
          class="w-12 h-12 rounded-2xl bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold"
        >
          <i data-lucide="car" class="w-6 h-6"></i>
        </div>
      </div>

      <div>
        <h4
          class="text-xs font-bold uppercase text-slate-400 mb-3 tracking-wider"
        >
          Pasajeros Confirmados:
        </h4>
        <div id="pasajeros-santi-r" class="space-y-2 min-h-24">
          <!-- Lista JS -->
        </div>
      </div>

      <form
        onsubmit="subirAlAuto(event, 'Santi R')"
        class="pt-2 border-t border-slate-800/80 space-y-3"
      >
        <label class="block text-xs font-bold uppercase text-slate-300"
          >Sumarme a este auto</label
        >
        <div class="flex gap-2">
          <input
            type="text"
            id="nombre-auto-santi-r"
            required
            placeholder="Tu nombre"
            class="flex-1 px-4 py-2.5 rounded-xl glass-input text-white text-sm focus:ring-2 focus:ring-amber-500"
          />
          <button
            type="submit"
            class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm transition flex items-center gap-1 shadow-lg shadow-amber-500/20"
          >
            <i data-lucide="user-plus" class="w-4 h-4"></i>
            Subirme
          </button>
        </div>
      </form>
    </div>
  </div>
</section>
